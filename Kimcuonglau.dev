<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nạp Kim Cương Lậu ✅ | Dịch Vụ AIM | Uy Tín Nhất</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --gold:#d4af37;--gold-dark:#b8860b;--gold-grad:linear-gradient(135deg,#d4af37,#b8860b);
  --green:#00b894;--green-grad:linear-gradient(135deg,#00b894,#00a885);
  --blue:#2563eb;--blue-grad:linear-gradient(135deg,#2563eb,#1d4ed8);
  --purple:#8b5cf6;--purple-grad:linear-gradient(135deg,#8b5cf6,#6d28d9);
  --orange:#f59e0b;--orange-grad:linear-gradient(135deg,#f59e0b,#d97706);
  --red:#ef4444;--red-grad:linear-gradient(135deg,#ef4444,#dc2626);
  --surface:#fff;--bg:#f8fafc;--text-main:#1e293b;--text-sub:#64748b;
  --border:#e2e8f0;--radius-sm:12px;--radius-md:18px;--radius-lg:24px;
  --shadow-sm:0 2px 8px rgba(0,0,0,.04);--shadow-md:0 8px 24px rgba(0,0,0,.06);
}
body{min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;
  color:var(--text-main);background:
    radial-gradient(circle at 5% 5%,rgba(212,175,55,.06) 0%,transparent 40%),
    radial-gradient(circle at 95% 10%,rgba(37,99,235,.05) 0%,transparent 45%),
    #f8fafc;
  background-attachment:fixed;
}
.container{width:94%;max-width:520px;margin:0 auto;position:relative;z-index:2;padding:20px 0}
.header{text-align:center;padding:28px 0 24px}
.header .logo{
  width:76px;height:76px;margin:0 auto 14px;background:var(--gold-grad);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 10px 30px rgba(212,175,55,.2);animation:float 3.5s ease-in-out infinite;
  overflow:hidden
}
.header .logo img{
  width:100%;height:100%;object-fit:cover;display:block
}
@keyframes float{0%{transform:translateY(0)}50%{transform:translateY(-6px)}100%{transform:translateY(0)}}
.header h1{font-size:24px;font-weight:800;margin-bottom:6px}
.header h1 span{background:var(--gold-grad);-webkit-background-clip:text;color:transparent}
.header p{color:var(--green);font-size:14px;font-weight:600}

.live-status{background:linear-gradient(90deg,rgba(0,184,148,.1),rgba(0,184,148,.04));
  border:1px solid rgba(0,184,148,.2);border-radius:var(--radius-lg);padding:16px 20px;margin-bottom:20px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.live-left{display:flex;align-items:center;gap:10px}
.live-dot{width:10px;height:10px;background:var(--green);border-radius:50%;
  box-shadow:0 0 0 4px rgba(0,184,148,.15),0 0 10px rgba(0,184,148,.35);animation:pulse 2s infinite}
@keyframes pulse{0%{opacity:1}50%{opacity:.5}100%{opacity:1}}
.live-text{font-size:14px;color:#065f46}
.live-count{font-weight:700;color:#0f172a}
.live-right{font-size:13px;background:#fff;padding:4px 12px;border-radius:50px}

.trust-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px 10px;text-align:center;box-shadow:var(--shadow-sm)}
.stat-number{font-size:18px;font-weight:800;color:var(--gold-dark);margin-bottom:2px}
.stat-label{font-size:11px;color:var(--text-sub)}

.badges-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.badge-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:18px 10px;text-align:center;box-shadow:var(--shadow-sm)}
.badge-icon{font-size:24px;margin-bottom:4px}
.badge-text{font-size:12px;font-weight:600}

.new-buyers{background:var(--surface);border-radius:var(--radius-lg);padding:20px;border:1px solid var(--border);margin-bottom:20px}
.new-title{font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.new-list{display:flex;flex-direction:column;gap:10px}
.new-item{font-size:14px;padding:12px 14px;background:rgba(0,184,148,.04);border-left:3px solid var(--green);border-radius:var(--radius-sm);animation:slideIn .5s ease}
@keyframes slideIn{from{opacity:0;transform:translateX(-6px)}to{opacity:1;transform:translateX(0)}}
.new-item strong{color:#047857}
.new-item span{color:var(--gold-dark);font-weight:600}

.nav-tabs{display:flex;gap:10px;margin-bottom:20px;position:sticky;top:10px;z-index:100;
  background:rgba(255,255,255,.9);padding:10px;border-radius:var(--radius-lg);border:1px solid rgba(0,0,0,.06);backdrop-filter:blur(8px)}
.nav-tab{flex:1;padding:12px 6px;border-radius:var(--radius-md);text-align:center;font-weight:700;font-size:14px;cursor:pointer;border:2px solid transparent;transition:.2s}
.nav-tab.active{background:var(--gold-grad);color:#fff;box-shadow:0 6px 20px rgba(212,175,55,.25)}
.nav-tab.aim-tab.active{background:var(--blue-grad);color:#fff;box-shadow:0 6px 20px rgba(37,99,235,.2)}
.nav-tab.tools-tab.active{background:var(--purple-grad);color:#fff;box-shadow:0 6px 20px rgba(139,92,246,.2)}
.tab-content{display:none;animation:fadeUp .4s ease}
.tab-content.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}

.card{background:var(--surface);border-radius:var(--radius-lg);padding:24px;border:1px solid var(--border);margin-bottom:20px;box-shadow:var(--shadow-sm)}
.card.hidden{display:none}
.card h3{font-size:18px;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.input-field{width:100%;padding:16px;border-radius:var(--radius-md);border:1px solid var(--border);background:#fafbfc;font-size:16px;outline:none}
.input-field:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.1)}

.packages{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.package{padding:20px 12px;border-radius:var(--radius-md);background:#fafbfc;border:2px solid transparent;text-align:center;cursor:pointer;transition:.2s}
.package:hover{border-color:rgba(212,175,55,.25)}
.package.active{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.1)}
.package .kc{color:var(--blue);font-weight:700;margin-bottom:4px;font-size:16px}
.package .price{color:var(--gold-dark);font-weight:600;font-size:15px}

.btn{width:100%;padding:16px;border-radius:var(--radius-md);border:none;font-size:16px;font-weight:800;cursor:pointer;transition:.2s;margin-top:24px}
.btn-gold{background:var(--gold-grad);color:#fff;box-shadow:0 8px 24px rgba(212,175,55,.25)}
.btn-blue{background:var(--blue-grad);color:#fff;box-shadow:0 8px 24px rgba(37,99,235,.2)}
.btn-purple{background:var(--purple-grad);color:#fff;box-shadow:0 8px 24px rgba(139,92,246,.2)}
.btn-green{background:var(--green-grad);color:#fff;box-shadow:0 8px 24px rgba(0,184,148,.2)}

.qr-box{width:240px;height:240px;margin:0 auto 20px;background:#fff;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-md);border:1px solid #f1f5f9;overflow:hidden}
.qr-box img{width:100%;height:100%;object-fit:contain;border-radius:var(--radius-sm)}

.payment-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:8px}
.label{color:var(--text-sub)}
.value{font-weight:600}
.copy-btn{padding:8px 14px;border-radius:var(--radius-sm);background:#f1f5f9;border:none;font-size:12px;cursor:pointer}
.note{margin-top:20px;padding:18px;background:rgba(212,175,55,.06);border-left:3px solid var(--gold);border-radius:0 var(--radius-md) var(--radius-md) 0;font-size:13px;line-height:1.7}
.note-aim{background:rgba(37,99,235,.04);border-left-color:var(--blue)}
.note-tools{background:rgba(139,92,246,.04);border-left-color:var(--purple)}
.success-msg{margin-top:20px;padding:18px;background:rgba(0,184,148,.06);border-radius:var(--radius-md);border:1px solid rgba(0,184,148,.2);color:#047857;font-weight:700;text-align:center;display:none}
.notice-msg{margin-top:20px;padding:18px;background:#fffbeb;border-radius:var(--radius-md);border:1px solid #f59e0b;color:#92400e;font-weight:600;text-align:center;display:none;line-height:1.6}

.contact-section{background:var(--surface);border-radius:var(--radius-lg);padding:24px;border:1px solid var(--border);margin-bottom:20px;box-shadow:var(--shadow-sm)}
.contact-title{font-size:18px;font-weight:700;color:var(--green);margin-bottom:20px;display:flex;align-items:center;gap:8px}
.contact-item{display:flex;align-items:center;gap:14px;padding:16px;background:#fafbfc;border-radius:var(--radius-md);margin-bottom:12px;border:1px solid transparent;transition:.2s}
.contact-item:hover{border-color:rgba(0,184,148,.25);background:#fff}
.contact-icon{font-size:24px}
.contact-label{font-size:13px;color:var(--text-sub);margin-bottom:2px}
.contact-val{font-size:15px;font-weight:600}

.cert-section{background:linear-gradient(135deg,#fffbeb,#fef3c7);border-radius:var(--radius-lg);padding:24px;border:1px solid rgba(212,175,55,.2);margin-bottom:20px;text-align:center}
.cert-title{font-size:16px;font-weight:700;color:var(--gold-dark);margin-bottom:10px}
.cert-list{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.cert-item{background:#fff;padding:8px 16px;border-radius:50px;font-size:13px;font-weight:600;color:var(--gold-dark);border:1px solid rgba(212,175,55,.3)}

.footer-section{text-align:center;padding:20px 10px;color:var(--text-sub);font-size:13px;line-height:1.8;border-top:1px solid var(--border);margin-top:10px}
.footer-title{font-size:15px;font-weight:700;color:var(--gold-dark);margin-bottom:4px}

.aim-card,.tools-card{border-radius:var(--radius-lg);padding:24px;border:1px solid rgba(0,0,0,.06);margin-bottom:20px}
.aim-card{background:linear-gradient(145deg,#eff6ff,#dbeafe)}
.tools-card{background:linear-gradient(145deg,#faf5ff,#f3e8ff)}
.card-title{font-size:20px;font-weight:900;margin-bottom:6px}
.aim-title{color:#1d4ed8}.tools-title{color:#7c3aed}
.card-desc{font-size:14px;margin-bottom:16px}
.aim-desc{color:#3b82f6}.tools-desc{color:#a855f7}
.features{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}
.feature{display:flex;align-items:center;gap:8px;font-size:15px}
.price-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.price-tab{border:2px solid transparent;border-radius:var(--radius-md);padding:14px 8px;text-align:center;cursor:pointer;transition:.2s}
.aim-price-tab{background:rgba(37,99,235,.06)}
.aim-price-tab.active{border-color:var(--blue);background:rgba(37,99,235,.1)}
.tools-price-tab{background:rgba(139,92,246,.06)}
.tools-price-tab.active{border-color:var(--purple);background:rgba(139,92,246,.1)}
.period{font-size:12px;margin-bottom:4px}
.aim-period{color:#3b82f6}.tools-period{color:#a855f7}
.pval{font-weight:800;font-size:16px}
.psale{font-size:11px;color:#dc2626;margin-top:2px;font-weight:600}
.total-row{display:flex;align-items:baseline;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.current-price{font-size:28px;font-weight:900;color:#0f172a}
.old-price{font-size:14px;color:#94a3b8;text-decoration:line-through}
.sale-tag{background:rgba(239,68,68,.08);color:#dc2626;padding:4px 12px;border-radius:50px;font-size:12px;font-weight:700}
.payment-wrap{max-height:0;overflow:hidden;opacity:0;transition:all .4s ease}
.payment-wrap.show{max-height:2000px;opacity:1;margin-top:20px}
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <div class="logo">
      <img src="https://cdn.upanhlaylink.com/i/WexgBwr8.jpg" alt="Avatar">
    </div>
    <h1><span>Nạp Kim Cương Lậu</span> ✅</h1>
    <p>🛡️ 100% KHÔNG BAN TÀI KHOẢN | Uy tín nhất 2025</p>
  </div>

  <div class="live-status">
    <div class="live-left">
      <span class="live-dot"></span>
      <span>Đang hoạt động • <span id="online-count">1,247</span> người truy cập</span>
    </div>
    <div class="live-right">24/7</div>
  </div>

  <div class="trust-stats">
    <div class="stat-card"><div class="stat-number">50K+</div><div class="stat-label">Khách hàng</div></div>
    <div class="stat-card"><div class="stat-number">99%</div><div class="stat-label">Hài lòng</div></div>
    <div class="stat-card"><div class="stat-number">2s</div><div class="stat-label">Xử lý</div></div>
    <div class="stat-card"><div class="stat-number">365</div><div class="stat-label">Ngày hoạt động</div></div>
  </div>

  <div class="badges-row">
    <div class="badge-item"><div class="badge-icon">💎</div><div class="badge-text">Nạp KC</div></div>
    <div class="badge-item"><div class="badge-icon">🎯</div><div class="badge-text">Dịch vụ AIM</div></div>
    <div class="badge-item"><div class="badge-icon">🛠️</div><div class="badge-text">Tools FB</div></div>
  </div>

  <div class="new-buyers">
    <p class="new-title">🔔 Người mua mới nhất</p>
    <div class="new-list" id="buyer-list"></div>
  </div>

  <div class="nav-tabs">
    <div class="nav-tab active" data-tab="kc" onclick="switchTab('kc')">💎 Gói KC</div>
    <div class="nav-tab aim-tab" data-tab="aim" onclick="switchTab('aim')">🎯 AIM</div>
    <div class="nav-tab tools-tab" data-tab="tools" onclick="switchTab('tools')">🛠️ Tools FB</div>
  </div>

  <!-- ===== PHẦN 1: GÓI KIM CƯƠNG ===== -->
  <div class="tab-content active" id="tab-kc">
    <div class="card">
      <h3>🎮 Nhập ID nhân vật</h3>
      <input type="text" id="uid" class="input-field" placeholder="Nhập ID tài khoản...">
    </div>

    <div class="card">
      <h3>💎 Chọn gói nạp</h3>
      <div class="packages">
        <div class="package" onclick="selPkg(this,'750 💎','50.000đ','KC50')">
          <div class="kc">750 💎</div><div class="price">50.000đ</div>
        </div>
        <div class="package" onclick="selPkg(this,'1.875 💎','100.000đ','KC100')">
          <div class="kc">1.875 💎</div><div class="price">100.000đ</div>
        </div>
        <div class="package" onclick="selPkg(this,'3.800 💎','200.000đ','KC200')">
          <div class="kc">3.800 💎</div><div class="price">200.000đ</div>
        </div>
        <div class="package" onclick="selPkg(this,'6.500 💎','300.000đ','KC300')">
          <div class="kc">6.500 💎</div><div class="price">300.000đ</div>
        </div>
        <div class="package" onclick="selPkg(this,'14.500 💎','500.000đ','KC500')">
          <div class="kc">14.500 💎</div><div class="price">500.000đ</div>
        </div>
        <div class="package" onclick="selPkg(this,'35.000 💎','1.000.000đ','KC1000')">
          <div class="kc">35.000 💎</div><div class="price">1.000.000đ</div>
        </div>
      </div>
      <button class="btn btn-gold" onclick="showPaymentKC()">👉 MUA NGAY</button>
    </div>

    <div class="card hidden" id="payment-kc">
      <h3 style="text-align:center">📲 Thanh toán</h3>
      <div class="qr-box"><img src="https://cdn.upanhlaylink.com/i/ZN5WBY3o.png" alt="QR Thanh toán"></div>
      <div class="payment-row"><span class="label">ID người dùng</span><span class="value" id="kc-uid">—</span></div>
      <div class="payment-row"><span class="label">Gói</span><span class="value" id="kc-pkg">—</span></div>
      <div class="payment-row"><span class="label">Số tiền</span><span class="value" id="kc-amt">—</span></div>
      <div class="payment-row"><span class="label">Nội dung</span><span class="value" id="kc-code">—</span><button class="copy-btn" onclick="copyText('kc-code')">Sao chép</button></div>
      <div class="payment-row"><span class="label">STK Momo</span><span class="value">0397240160</span><button class="copy-btn" onclick="navigator.clipboard.writeText('0397240160').then(()=>alert('Đã sao chép!'))">Sao chép</button></div>
      <div class="payment-row"><span class="label">Tên tài khoản</span><span class="value">Nguyễn Danh Việt</span></div>
      <div class="note">
        ⚠️ <strong>Lưu ý:</strong><br>
        • Quét QR để thanh toán<br>
        • Ghi đúng nội dung chuyển khoản kèm ID<br>
        • Hệ thống tự động cộng sau 1-3 phút
      </div>
      <button class="btn btn-green" onclick="doneKC()">✅ ĐÃ THANH TOÁN</button>
      <div class="success-msg" id="success-kc">✅ Thành công! Kim cương sẽ được cộng sớm nhất</div>
    </div>
  </div>

  <!-- ===== PHẦN 2: DỊCH VỤ AIM ===== -->
  <div class="tab-content" id="tab-aim">
    <div class="aim-card">
      <h3 class="card-title aim-title">🎯 Dịch Vụ AIM</h3>
      <p class="card-desc aim-desc">Nhắm tự động chính xác • An toàn cao • Không bị ban</p>
      <div class="features">
        <div class="feature">✓ Khóa mục tiêu tự động</div>
        <div class="feature">✓ Tùy chỉnh độ nhạy & phạm vi</div>
        <div class="feature">✓ Hoạt động ẩn, không phát hiện</div>
        <div class="feature">✓ Hỗ trợ mọi phiên bản game</div>
      </div>
      <div class="price-tabs">
        <div class="price-tab aim-price-tab" data-pkg="AIM - Ngày" data-price="50.000đ" data-code="AIMNGAY" onclick="selAIMPkg(this)">
          <div class="period aim-period">NGÀY</div><div class="pval">50.000đ</div><div class="psale">Giá gốc</div>
        </div>
        <div class="price-tab aim-price-tab active" data-pkg="AIM - Tuần" data-price="100.000đ" data-code="AIMTUAN" onclick="selAIMPkg(this)">
          <div class="period aim-period">TUẦN</div><div class="pval">100.000đ</div><div class="psale">-30%</div>
        </div>
        <div class="price-tab aim-price-tab" data-pkg="AIM - Tháng" data-price="250.000đ" data-code="AIMTHANG" onclick="selAIMPkg(this)">
          <div class="period aim-period">THÁNG</div><div class="pval">250.000đ</div><div class="psale">-50%</div>
        </div>
      </div>
      <div class="total-row"><span class="current-price" id="aim-cur">100.000đ</span></div>
      <button class="btn btn-blue" id="btn-aim" onclick="showPaymentAIM()">🛒 MUA NGAY</button>
      <div class="payment-wrap" id="payment-aim">
        <h3 style="text-align:center;margin-top:20px">📲 Thanh toán AIM</h3>
        <div class="qr-box"><img src="https://cdn.upanhlaylink.com/i/ZN5WBY3o.png" alt="QR Thanh toán"></div>
        <div class="payment-row"><span class="label">Sản phẩm</span><span class="value" id="aim-pkg">AIM - Tuần</span></div>
        <div class="payment-row"><span class="label">Số tiền</span><span class="value" id="aim-amt">100.000đ</span></div>
        <div class="payment-row"><span class="label">Nội dung</span><span class="value" id="aim-code">AIMTUAN</span><button class="copy-btn" onclick="copyText('aim-code')">Sao chép</button></div>
        <div class="payment-row"><span class="label">STK Momo</span><span class="value">0397240160</span><button class="copy-btn" onclick="navigator.clipboard.writeText('0397240160').then(()=>alert('Đã sao chép!'))">Sao chép</button></div>
        <div class="payment-row"><span class="label">Tên tài khoản</span><span class="value">Nguyễn Danh Việt</span></div>
        <div class="note note-aim">
          ⚠️ <strong>Lưu ý:</strong><br>
          • Ghi đúng nội dung<br>
          • Chụp bill gửi Zalo sau khi thanh toán
        </div>
        <button class="btn btn-green" onclick="doneAIM()">✅ ĐÃ THANH TOÁN</button>
        <div class="notice-msg" id="notice-aim">
          📸 Chụp bill gửi qua Zalo <strong>0932495028</strong> để được hỗ trợ cài đặt và khi thanh toán thành công mới có file ạ
        </div>
      </div>
    </div>
  </div>

  <!-- ===== PHẦN 3: TOOLS DAME FB ===== -->
  <div class="tab-content" id="tab-tools">
    <div class="tools-card">
      <h3 class="card-title tools-title">🛠️ Tools Dame FB</h3>
      <p class="card-desc tools-desc">Công cụ hỗ trợ • Tăng tương tác • An toàn & ổn định</p>
      <div class="features">
        <div class="feature">✓ Tăng tương tác tự động</div>
        <div class="feature">✓ Hỗ trợ nhiều tài khoản</div>
        <div class="feature">✓ Bảo mật thông tin cao</div>
        <div class="feature">✓ Cập nhật liên tục & hỗ trợ 24/7</div>
      </div>
      <div class="price-tabs">
        <div class="price-tab tools-price-tab" data-pkg="Tools FB - Ngày" data-price="100.000đ" data-code="TOOLSNGAY" onclick="selToolsPkg(this)">
          <div class="period tools-period">NGÀY</div><div class="pval">100.000đ</div><div class="psale">Giá gốc</div>
        </div>
        <div class="price-tab tools-price-tab active" data-pkg="Tools FB - Tuần" data-price="150.000đ" data-code="TOOLSTUAN" onclick="selToolsPkg(this)">
          <div class="period tools-period">TUẦN</div><div class="pval">150.000đ</div><div class="psale">-35%</div>
        </div>
        <div class="price-tab tools-price-tab" data-pkg="Tools FB - Tháng" data-price="350.000đ" data-code="TOOLSTHANG" onclick="selToolsPkg(this)">
          <div class="period tools-period">THÁNG</div><div class="pval">350.000đ</div><div class="psale">-55%</div>
        </div>
      </div>
      <div class="total-row"><span class="current-price" id="tools-cur">150.000đ</span></div>
      <button class="btn btn-purple" id="btn-tools" onclick="showPaymentTools()">🛒 MUA NGAY</button>
      <div class="payment-wrap" id="payment-tools">
        <h3 style="text-align:center;margin-top:20px">📲 Thanh toán Tools FB</h3>
        <div class="qr-box"><img src="https://cdn.upanhlaylink.com/i/ZN5WBY3o.png" alt="QR Thanh toán"></div>
        <div class="payment-row"><span class="label">Sản phẩm</span><span class="value" id="tools-pkg">Tools FB - Tuần</span></div>
        <div class="payment-row"><span class="label">Số tiền</span><span class="value" id="tools-amt">150.000đ</span></div>
        <div class="payment-row"><span class="label">Nội dung</span><span class="value" id="tools-code">TOOLSTUAN</span><button class="copy-btn" onclick="copyText('tools-code')">Sao chép</button></div>
        <div class="payment-row"><span class="label">STK Momo</span><span class="value">0397240160</span><button class="copy-btn" onclick="navigator.clipboard.writeText('0397240160').then(()=>alert('Đã sao chép!'))">Sao chép</button></div>
        <div class="payment-row"><span class="label">Tên tài khoản</span><span class="value">Nguyễn Danh Việt</span></div>
        <div class="note note-tools">
          ⚠️ <strong>Lưu ý:</strong><br>
          • Ghi đúng nội dung<br>
          • Chụp bill gửi Zalo sau khi thanh toán
        </div>
        <button class="btn btn-green" onclick="doneTools()">✅ ĐÃ THANH TOÁN</button>
        <div class="notice-msg" id="notice-tools">
          📸 Chụp bill gửi qua Zalo <strong>0932495028</strong> để được hỗ trợ cài đặt và khi thanh toán thành công mới có file ạ
        </div>
      </div>
    </div>
  </div>

  <!-- ===== LIÊN HỆ ===== -->
  <div class="contact-section">
    <h3 class="contact-title">📞 Liên hệ & Hỗ trợ</h3>
    <div class="contact-item">
      <span class="contact-icon">💬</span>
      <div><div class="contact-label">Zalo / Điện thoại</div><div class="contact-val">0932495028</div></div>
    </div>
    <div class="contact-item">
      <span class="contact-icon">⏰</span>
      <div><div class="contact-label">Thời gian hỗ trợ</div><div class="contact-val">24/7 — Bao gồm lễ & cuối tuần</div></div>
    </div>
    <div class="contact-item">
      <span class="contact-icon">🛡️</span>
      <div><div class="contact-label">Bảo hành</div><div class="contact-val">Hoàn tiền 100% nếu không nhận được</div></div>
    </div>
  </div>

  <!-- ===== CHỨNG CHỈ ===== -->
  <div class="cert-section">
    <p class="cert-title">🏆 Chứng chỉ & Uy tín</p>
    <div class="cert-list">
      <span class="cert-item">✅ Đã xác minh chính thức</span>
      <span class="cert-item">🛡️ An toàn bảo mật</span>
      <span class="cert-item">⭐ 50.000+ Khách hàng</span>
      <span class="cert-item">💎 Uy tín hàng đầu</span>
    </div>
  </div>

  <!-- ===== FOOTER ===== -->
  <div class="footer-section">
    <p class="footer-title">© 2025 Nạp Kim Cương Lậu</p>
    <p>Dịch vụ uy tín số 1 Việt Nam • Tất cả quyền được bảo lưu</p>
  </div>
</div>

<script>
let selectedPkg = '', selectedAmt = '', selectedCode = '';

// Dữ liệu người mua - Ẩn ID dạng ****
const buyers = [
  {id:'2837****52', name:'Nguyễn***An', item:'750 💎'},
  {id:'9872****13', name:'Trần***Bình', item:'1.875 💎'},
  {id:'4561****98', name:'Lê***Chi', item:'AIM - Ngày'},
  {id:'3215****76', name:'Phạm***Dũng', item:'Tools FB - Tuần'},
  {id:'6549****21', name:'Hoàng***Em', item:'6.500 💎'},
  {id:'7893****45', name:'Vũ***Phúc', item:'AIM - Tháng'},
  {id:'1472****69', name:'Đặng***Giang', item:'Tools FB - Ngày'},
  {id:'9638****14', name:'Bùi***Hải', item:'35.000 💎'}
];

// Hiển thị người mua mới nhất - ID đã ẩn
function renderBuyers(){
  const list = document.getElementById('buyer-list');
  list.innerHTML = '';
  const shuffled = [...buyers].sort(()=>Math.random()-0.5).slice(0,4);
  shuffled.forEach(b=>{
    const div = document.createElement('div');
    div.className = 'new-item';
    div.innerHTML = `<strong>${b.name}</strong> • ID: ${b.id}<br>Đã mua: <span>${b.item}</span>`;
    list.appendChild(div);
  });
}
renderBuyers();
setInterval(renderBuyers, 8000);

// Chuyển tab
function switchTab(tab){
  document.querySelectorAll('.tab-content').forEach(el=>el.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(el=>el.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  document.querySelector(`[data-tab="${tab}"]`).classList.add('active');
}

// Chọn gói KC
function selPkg(el,pkg,amt,code){
  document.querySelectorAll('.package').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  selectedPkg = pkg;
  selectedAmt = amt;
  selectedCode = code;
}

// Hiện thanh toán KC
function showPaymentKC(){
  if(!selectedCode) return alert('Vui lòng chọn gói nạp!');
  const uid = document.getElementById('uid').value || 'Chưa nhập';
  document.getElementById('kc-uid').textContent = uid;
  document.getElementById('kc-pkg').textContent = selectedPkg;
  document.getElementById('kc-amt').textContent = selectedAmt;
  document.getElementById('kc-code').textContent = selectedCode + ' ' + uid;
  document.getElementById('payment-kc').classList.remove('hidden');
  document.getElementById('payment-kc').scrollIntoView({behavior:'smooth'});
}

// KC: giữ nguyên thông báo cũ
function doneKC(){ document.getElementById('success-kc').style.display='block'; }

// === AIM: Chọn gói Ngày/Tuần/Tháng ===
function selAIMPkg(el){
  document.querySelectorAll('.aim-price-tab').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('aim-cur').textContent = el.dataset.price;
}

function showPaymentAIM(){
  const active = document.querySelector('.aim-price-tab.active');
  document.getElementById('aim-pkg').textContent = active.dataset.pkg;
  document.getElementById('aim-amt').textContent = active.dataset.price;
  document.getElementById('aim-code').textContent = active.dataset.code;
  // Ẩn lại thông báo khi đổi gói
  document.getElementById('notice-aim').style.display='none';
  document.getElementById('payment-aim').classList.add('show');
  document.getElementById('payment-aim').scrollIntoView({behavior:'smooth'});
}

// AIM: Sửa nội dung hiển thị
function doneAIM(){
  document.getElementById('notice-aim').style.display='block';
}

// === Tools FB: Chọn gói Ngày/Tuần/Tháng ===
function selToolsPkg(el){
  document.querySelectorAll('.tools-price-tab').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tools-cur').textContent = el.dataset.price;
}

function showPaymentTools(){
  const active = document.querySelector('.tools-price-tab.active');
  document.getElementById('tools-pkg').textContent = active.dataset.pkg;
  document.getElementById('tools-amt').textContent = active.dataset.price;
  document.getElementById('tools-code').textContent = active.dataset.code;
  // Ẩn lại thông báo khi đổi gói
  document.getElementById('notice-tools').style.display='none';
  document.getElementById('payment-tools').classList.add('show');
  document.getElementById('payment-tools').scrollIntoView({behavior:'smooth'});
}

// Tools FB: Sửa nội dung hiển thị
function doneTools(){
  document.getElementById('notice-tools').style.display='block';
}

// Sao chép nội dung
function copyText(id){
  const txt = document.getElementById(id).textContent;
  navigator.clipboard.writeText(txt).then(()=>alert('Đã sao chép: ' + txt));
}
</script>
</body>
</html>
